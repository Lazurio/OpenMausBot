      "expect": {
        "type": "lazurio-browser:identity",
        "v": 1,
        "identity": {
          "id": "vm-01.acme",
          "name": "vm-01",
          "who": "Acme",
          "glyph": {
            "kind": "initials",
            "text": "AC"
          }
        },
        "majors": [
          1
        ]
      }
    },
    {
      "name": "an app that does not know the Environment answers none",
      "call": "identityReplyMessage",
      "args": [
        null
      ],
      "expect": {
        "type": "lazurio-browser:identity",
        "v": 1,
        "identity": null
      }
