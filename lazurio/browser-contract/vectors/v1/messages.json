        "v": 1,
        "view": "https://browser.vm-01.acme.lazurio.io/t/0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B",
        "url": "https://example.com/a"
      }
    },
    {
      "name": "the view's tab ended",
      "call": "viewClosedMessage",
      "args": [
        "https://browser.vm-01.acme.lazurio.io/t/0A0A0A0A0A0A0A0A0A0A0A0A0A0A0A0A"
      ],
      "expect": {
        "type": "lazurio-browser:closed",
        "v": 1,
        "view": "https://browser.vm-01.acme.lazurio.io/t/0A0A0A0A0A0A0A0A0A0A0A0A0A0A0A0A"
      }
    },
    {
      "name": "the view asks for the identity",
      "call": "identityRequestMessage",
      "args": [],
      "expect": {
        "type": "lazurio-browser:identity-request",
        "v": 1
      }
    },
    {
      "name": "the app's answer with the shell's identity",
      "call": "identityReplyMessage",
      "args": [
        {
          "id": "vm-01.acme",
          "name": "vm-01",
          "who": "Acme",
          "glyph": {
            "kind": "initials",
            "text": "AC"
          }
        }
      ],
      "expect": {
        "type": "lazurio-browser:identity",
        "v": 1,
        "identity": {
          "id": "vm-01.acme",
          "name": "vm-01",
          "who": "Acme",
          "glyph": {
            "kind": "initials",
            "text": "AC"
          }
        }
      }
    },
    {
      "name": "the app's answer names the majors its parser reads",
      "call": "identityReplyMessage",
      "args": [
        {
          "id": "vm-01.acme",
          "name": "vm-01",
          "who": "Acme",
          "glyph": {
            "kind": "initials",
            "text": "AC"
          }
        },
