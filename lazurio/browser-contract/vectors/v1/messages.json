{
  "schema": "lazurio.browser-vectors.v1",
  "contract": "messages",
  "cases": [
    {
      "name": "the five types",
      "call": "browserMessage",
      "expect": {
        "info": "lazurio-browser:info",
        "newTab": "lazurio-browser:new-tab",
        "closed": "lazurio-browser:closed",
        "identityRequest": "lazurio-browser:identity-request",
        "identity": "lazurio-browser:identity"
      }
    },
    {
      "name": "v1",
      "call": "messageMajors",
      "expect": [
        1
      ]
    },
    {
      "name": "whole numbers from 1, each once",
      "call": "parseMessageMajors",
      "args": [
        [
          1,
          2
        ]
      ],
      "expect": [
        1,
        2
      ]
    },
    {
      "name": "one major",
      "call": "parseMessageMajors",
      "args": [
        [
          1
        ]
      ],
      "expect": [
        1
      ]
    },
    {
      "name": "none named",
      "call": "parseMessageMajors",
      "args": [
        {
          "$": "undefined"
        }
      ],
      "expect": null
    },
    {
      "name": "an empty list names none",
      "call": "parseMessageMajors",
      "args": [
        []
      ],
      "expect": null
    },
    {
      "name": "a major twice",
      "call": "parseMessageMajors",
      "args": [
        [
          1,
          1
        ]
      ],
      "expect": null
    },
    {
      "name": "a major below 1",
      "call": "parseMessageMajors",
      "args": [
        [
          0,
          1
        ]
      ],
      "expect": null
    },
    {
      "name": "a fraction",
      "call": "parseMessageMajors",
      "args": [
        [
          1.5
        ]
      ],
      "expect": null
    },
    {
      "name": "a text",
      "call": "parseMessageMajors",
      "args": [
        [
          "1"
        ]
      ],
      "expect": null
    },
    {
      "name": "not a list",
      "call": "parseMessageMajors",
      "args": [
        1
      ],
      "expect": null
    },
    {
      "name": "an app as deployed today names no majors: v1",
      "call": "messageMajor",
      "args": [
        null
      ],
      "expect": 1
    },
    {
      "name": "an app that reads v1",
      "call": "messageMajor",
      "args": [
        [
          1
        ]
      ],
      "expect": 1
    },
    {
      "name": "the highest both read",
      "call": "messageMajor",
      "args": [
        [
          2,
          1
        ]
      ],
      "expect": 1
    },
    {
      "name": "an app that reads no major of these gets nothing",
      "call": "messageMajor",
      "args": [
        [
          2
        ]
      ],
      "expect": null
    },
    {
      "name": "where the view's tab is, named by its view address",
      "call": "viewInfoMessage",
      "args": [
        "https://browser.vm-01.acme.lazurio.io/t/0A0A0A0A0A0A0A0A0A0A0A0A0A0A0A0A",
        "https://example.com/",
        "Example"
      ],
      "expect": {
        "type": "lazurio-browser:info",
        "v": 1,
        "view": "https://browser.vm-01.acme.lazurio.io/t/0A0A0A0A0A0A0A0A0A0A0A0A0A0A0A0A",
        "url": "https://example.com/",
        "title": "Example"
      }
    },
    {
      "name": "a new tab of the view's page",
      "call": "viewNewTabMessage",
      "args": [
        "https://browser.vm-01.acme.lazurio.io/t/0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B",
