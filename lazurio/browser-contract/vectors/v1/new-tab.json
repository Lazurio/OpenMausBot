    {
      "name": "a tool",
      "call": "parseNewTabChoice",
      "args": [
        {
          "kind": "tool",
          "id": "terminal"
        }
      ],
      "expect": {
        "kind": "tool",
        "id": "terminal"
      }
    },
    {
      "name": "members it does not know are ignored",
      "call": "parseNewTabChoice",
      "args": [
        {
          "kind": "tool",
          "id": "terminal",
          "later": true
        }
      ],
      "expect": {
        "kind": "tool",
        "id": "terminal"
      }
    },
