    {
      "name": "the registry of tool ids and their icons",
      "call": "newTabToolIcons",
      "expect": {
        "terminal": "terminal",
        "files": "files",
        "diff": "diff",
        "pull-request": "pull-request",
        "linked-pull-requests": "pull-request",
        "agents": "bot",
        "device": "device"
      }
    },
    {
      "name": "a registry id draws its icon",
      "call": "newTabToolIcon",
      "args": [
        {
          "id": "terminal"
        }
      ],
      "expect": "terminal"
    },
    {
      "name": "linked pull requests draw the pull request's icon",
      "call": "newTabToolIcon",
      "args": [
        {
          "id": "linked-pull-requests",
          "icon": "linked-pull-requests"
        }
      ],
      "expect": "pull-request"
    },
    {
      "name": "agents draw the bot",
      "call": "newTabToolIcon",
      "args": [
        {
          "id": "agents"
        }
      ],
      "expect": "bot"
    },
    {
      "name": "an id outside the registry draws the icon it names in the registry",
      "call": "newTabToolIcon",
      "args": [
        {
          "id": "my-shell",
          "icon": "terminal"
        }
      ],
      "expect": "terminal"
    },
    {
      "name": "an id outside the registry without such an icon draws the default",
      "call": "newTabToolIcon",
      "args": [
        {
          "id": "my-tool",
          "icon": "sparkles"
        }
      ],
      "expect": "grid"
    },
    {
      "name": "an id outside the registry without an icon draws the default",
      "call": "newTabToolIcon",
      "args": [
        {
          "id": "my-tool"
        }
      ],
      "expect": "grid"
    }
  ]
