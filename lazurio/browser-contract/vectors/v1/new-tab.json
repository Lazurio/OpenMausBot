{
  "schema": "lazurio.browser-vectors.v1",
  "contract": "new-tab",
  "cases": [
    {
      "name": "the element's event",
      "call": "newTabEventName",
      "expect": "lazurio-new-tab"
    },
    {
      "name": "twelve tools at most",
      "call": "maxNewTabTools",
      "expect": 12
    },
    {
      "name": "tools with an id, a label, a letter and an icon",
      "call": "parseNewTabTools",
      "args": [
        [
          {
            "id": "terminal",
            "label": "Terminal",
            "key": "T",
            "icon": "terminal"
          },
          {
            "id": "files",
            "label": "Files",
            "key": "F",
            "icon": "files"
          }
        ]
      ],
      "expect": [
        {
          "id": "terminal",
          "label": "Terminal",
          "key": "T",
          "icon": "terminal"
        },
        {
          "id": "files",
          "label": "Files",
          "key": "F",
          "icon": "files"
        }
      ]
    },
    {
      "name": "no tools",
      "call": "parseNewTabTools",
      "args": [
        []
      ],
      "expect": []
    },
    {
      "name": "an id and a label alone",
      "call": "parseNewTabTools",
      "args": [
        [
          {
            "id": "agents",
            "label": "Agents"
          }
        ]
      ],
      "expect": [
        {
          "id": "agents",
          "label": "Agents"
        }
      ]
    },
