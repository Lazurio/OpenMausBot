        "view": "https://browser.vm-01.acme.lazurio.io/t/0123456789ABCDEF0123456789ABCDEF"
      }
    },
    {
      "name": "another Environment's view is a view all the same",
      "call": "parseNewTabChoice",
      "args": [
        {
          "kind": "tab",
          "tab": "0123456789ABCDEF0123456789ABCDEF",
          "view": "https://browser.vm-02.acme.lazurio.io/t/0123456789ABCDEF0123456789ABCDEF"
