    {
      "name": "the tab's view, as the contract writes it",
      "call": "newTabViewOf",
      "args": [
        "https://browser.vm-01.acme.lazurio.io/t/0123456789abcdef0123456789abcdef",
        "0123456789ABCDEF0123456789ABCDEF"
      ],
      "expect": "https://browser.vm-01.acme.lazurio.io/t/0123456789ABCDEF0123456789ABCDEF"
    },
    {
      "name": "another tab's view is none",
      "call": "newTabViewOf",
      "args": [
        "https://browser.vm-01.acme.lazurio.io/t/FEDCBA9876543210FEDCBA9876543210",
        "0123456789ABCDEF0123456789ABCDEF"
      ],
      "expect": null
    },
    {
      "name": "a view with a query is none",
      "call": "newTabViewOf",
      "args": [
        "https://browser.vm-01.acme.lazurio.io/t/0123456789ABCDEF0123456789ABCDEF?x=1",
        "0123456789ABCDEF0123456789ABCDEF"
      ],
      "expect": null
    },
    {
      "name": "a page with its view",
      "call": "parseNewTabChoice",
      "args": [
        {
          "kind": "page",
          "tab": "0123456789ABCDEF0123456789ABCDEF",
          "view": "https://browser.vm-01.acme.lazurio.io/t/0123456789ABCDEF0123456789ABCDEF"
