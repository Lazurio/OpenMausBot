      "expect": {
        "kind": "refused",
        "reason": "view"
      }
    },
    {
      "name": "on a view host, a base that is no DNS label is refused",
      "call": "addressBarTarget",
      "args": [
        "https://browser.-vm.acme.lazurio.io/t/0123456789ABCDEF0123456789ABCDEF",
